# Copy to .env.local and fill in. Only VITE_* vars are exposed to the browser —
# never put private secrets here.

# Backend endpoint that receives quote + contact leads (POST JSON).
# Leave empty to run in demo mode (submissions are simulated).
VITE_API_ENDPOINT=
# Optional public key sent as X-Api-Key header (must be a publishable key)
VITE_API_PUBLIC_KEY=

# Public site URL used for canonical / og:url tags
VITE_SITE_URL=https://happy-new-remix.lovable.app

# Maps (publishable browser key, restrict by HTTP referrer)
VITE_MAPBOX_TOKEN=
VITE_GOOGLE_MAPS_API_KEY=

# Analytics / tracking pixels
VITE_GA_MEASUREMENT_ID=
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=
