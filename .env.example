# Copy to .env.local and fill in. Only VITE_* vars reach the browser —
# never put private secrets here. On Lovable Cloud these are set automatically.

# Backend (publishable values only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public, referrer-restricted map browser token
VITE_MAP_PROVIDER_PUBLIC_TOKEN=

# Optional endpoint that receives quote + contact leads (POST JSON). Empty = demo mode.
VITE_API_ENDPOINT=
VITE_API_PUBLIC_KEY=

# Public site URL used for canonical / og:url tags
VITE_SITE_URL=https://happy-new-remix.lovable.app

# Analytics / tracking pixels
VITE_GA_MEASUREMENT_ID=
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=

# Optional HTTPS partner URL templates; {query} is URL-encoded.
VITE_AFFILIATE_STAY_URL=
VITE_AFFILIATE_TOUR_URL=
VITE_AFFILIATE_TRANSIT_URL=
